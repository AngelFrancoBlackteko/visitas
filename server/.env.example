# --- Required ---
# Used to sign JWTs. Generate with: openssl rand -hex 64
# The server refuses to start if this is empty, a placeholder, or < 32 chars.
JWT_SECRET=

# --- Optional ---
PORT=3000
NODE_ENV=development
DATA_DIR=./data
LOG_LEVEL=info

# JWT lifetime in seconds (default 12h)
JWT_TTL_SECONDS=43200

# External-facing base URL — used for links in emails, QR-coded invite URLs, etc.
# Falls back to http://localhost:PORT if unset.
BASE_URL=

# --- Active Directory bind password (only if AD enabled in config/auth.json) ---
AD_BIND_PASSWORD=

# --- SMTP password (only if email enabled in config/notifications.json) ---
SMTP_PASSWORD=

# --- SMS adapter credentials (only if SMS enabled, e.g. Twilio) ---
SMS_AUTH_TOKEN=

# Browser alerts (Web Push). Optional: without these, a key pair is created
# on first use and kept in the database. Set them only to pin the keys.
# Changing them makes every host turn alerts on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
