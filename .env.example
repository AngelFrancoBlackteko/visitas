# Top-level .env used by docker-compose.
# For non-Docker development, see server/.env.example instead.
#
# Supported install path: `sudo ./install.sh` — it creates a `visitas`
# system account on the host at UID/GID 10001 (matching the image),
# generates JWT_SECRET below, and chowns ./data/. Hand-editing also works.

# REQUIRED — generate with: openssl rand -hex 64
# The server refuses to start if this is empty, the old example placeholder,
# or shorter than 32 characters.
JWT_SECRET=

# Optional — numeric override for the container's user/group. The image and
# install.sh both default to the `visitas` account at UID/GID 10001, and
# docker compose resolves the name without anything set here. Only set
# these if 10001 was already taken on the host and install.sh had to fall
# back to a different UID/GID.
VISITAS_UID=
VISITAS_GID=

# Public URL the kiosk is served on. install.sh sets this to
# https://<domain> when --domain is used. The server uses the scheme to
# decide whether to mark the session cookie Secure — set this to your
# real https://host if you wire up TLS by hand.
BASE_URL=

# Set to 1 when traffic reaches visitas through the bundled Caddy (or any
# single reverse proxy), so per-IP rate limits use the real client address.
# Leave blank when clients connect straight to :3000 — trusting the header
# there would let a client spoof its IP and dodge the limits.
TRUST_PROXY=

# Activates the `caddy` service in docker-compose.yml. install.sh sets
# this to "tls" when --domain is used. Leave blank for HTTP-only on :3000.
COMPOSE_PROFILES=

# Optional
VISITAS_PORT=3000
JWT_TTL_SECONDS=43200
LOG_LEVEL=info

# Active Directory bind password (only if AD enabled in config/auth.json)
AD_BIND_PASSWORD=

# SMTP password (only if email enabled in config/notifications.json)
SMTP_PASSWORD=

# SMS provider auth token (e.g. Twilio Auth Token)
SMS_AUTH_TOKEN=
