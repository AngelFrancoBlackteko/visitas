# Top-level .env used by docker-compose.
# For non-Docker development, see server/.env.example instead.
#
# Supported install path: `sudo ./install.sh` — it creates a `visitas`
# system account on the host at UID/GID 10001 (matching the image),
# generates JWT_SECRET below, and chowns ./data/. Hand-editing also works.

# REQUIRED — generate with: openssl rand -hex 64
JWT_SECRET=change-me-please

# Optional — numeric override for the container's user/group. The image and
# install.sh both default to the `visitas` account at UID/GID 10001, and
# docker compose resolves the name without anything set here. Only set
# these if 10001 was already taken on the host and install.sh had to fall
# back to a different UID/GID.
VISITAS_UID=
VISITAS_GID=

# Optional
VISITAS_PORT=3000
JWT_TTL_SECONDS=43200
LOG_LEVEL=info

# Active Directory bind password (only if AD enabled in config/auth.json)
AD_BIND_PASSWORD=

# SMTP password (only if email enabled in config/notifications.json)
SMTP_PASSWORD=

# SMS provider auth token (e.g. Twilio Auth Token)
SMS_AUTH_TOKEN=
